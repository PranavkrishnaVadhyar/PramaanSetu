DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/doc_screening
HF_API_TOKEN=
STORAGE_PATH=./storage
RISK_MODEL_PATH=./app/modules/module5_risk/model.joblib

# Local-only OCR model. Provision it explicitly with provision_paddle_ocr_model.py.
PADDLE_OCR_MODEL_NAME=PP-OCRv5_mobile_rec_safetensors
PADDLE_OCR_MODEL_DIR=./models/pp-ocrv5-mobile-rec
PADDLE_OCR_DEVICE=cpu
PADDLE_OCR_ENABLE_MKLDNN=true

# Auth — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=10080
